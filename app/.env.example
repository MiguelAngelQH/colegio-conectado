# Servidor del colegio (Supabase). Obligatorio para publicar: npm run build falla sin estas variables.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Al programar (npm run dev) sin estas variables la app usa el modo demostración.
# Para publicar una versión de demostración use npm run build:demo (lee .env.demo).
